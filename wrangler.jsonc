{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "build": {
    "command": "pnpm build:cf"
  },
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_PERSONAL_EMAIL": "akshaysinghthakur0004@gmail.com",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADfQS4i8bVY-iZju",
    "NEXT_PUBLIC_RESUME_URL": "https://drive.google.com/file/d/11AYsoQ7bWiZlxx6HINi7e-d34FeXOKM9/view?usp=sharing"
  },
  "observability": {
    "enabled": true
  }
}
